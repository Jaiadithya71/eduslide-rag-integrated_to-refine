QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=presentations

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:8501

# Environment
ENVIRONMENT=development
DEBUG=True
