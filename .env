# Groq AI Configuration (FREE - Get from: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

FREEPIK_API_KEY=

GEMINI_API_KEY=

# Qdrant Configuration (Local - No key needed)
